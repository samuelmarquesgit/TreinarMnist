# ==============================================================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ==============================================================================
AMBIENTE_EXECUCAO=desenvolvimento
SEMENTE_ALEATORIA=42
NIVEL_LOG=INFO

# ==============================================================================
# BANCO DE DADOS RELACIONAL: POSTGRESQL (Docker)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnist_database
POSTGRES_USER=mnist_user
POSTGRES_PASSWORD=mnist_secret_123

# ==============================================================================
# BANCO DE DADOS NÃO-RELACIONAL: MONGODB (Docker)
# ==============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=mnist_nosql
MONGO_USER=mongo_admin
MONGO_PASSWORD=mongo_secret_123

# ==============================================================================
# BASE VETORIAL & RAG (ChromaDB Local)
# ==============================================================================
DIRETORIO_CHROMA=data/processed/chroma_db
COLECAO_RAG=mnist_conhecimento

# ==============================================================================
# SERVIDOR MCP (Model Context Protocol)
# ==============================================================================
MCP_NOME_SERVIDOR=servidor-mnist-ia
MCP_VERSAO=1.0.0

# ==============================================================================
# API REST DE INFERÊNCIA (Módulo 2) — todas opcionais, os padrões já funcionam
# Caminhos relativos são resolvidos a partir da raiz do projeto.
# ==============================================================================
MNIST_API_CAMINHO_MODELO=models/modelo_mnist_v1.joblib
MNIST_API_CAMINHO_CHECKSUM=models/modelo_mnist_v1.sha256
MNIST_API_CAMINHO_METRICAS=models/metricas_modelo_v1.json
MNIST_API_VERSAO_API=2.0.0
MNIST_API_LIMIAR_CONFIANCA=0.85
MNIST_API_LIMIAR_ENTROPIA=0.3
MNIST_API_TAMANHO_MAX_UPLOAD_BYTES=2097152
# Resolução máxima da imagem enviada (largura × altura); barra "bombas de descompressão"
MNIST_API_MAX_PIXELS_IMAGEM=25000000
MNIST_API_TAMANHO_MAX_LOTE=100
# Expõe a rota que força erro 500 (somente testes/Postman; nunca em produção)
MNIST_API_HABILITAR_DIAGNOSTICO=false
MNIST_API_NIVEL_LOG=INFO
